    // 13. CSV & JSON IMPORT / EXPORT HANDLERS (FILEREADER)
    // -----------------------------------------------------------------------
    function parseCSV(text) {
      const rows = [];
      let currentRow = [];
      let currentCell = '';
      let insideQuotes = false;

      for (let i = 0; i < text.length; i++) {
        const char = text[i];
        const nextChar = text[i + 1];

        if (char === '"') {
          if (insideQuotes && nextChar === '"') {
            currentCell += '"';
            i++;
          } else {
            insideQuotes = !insideQuotes;
          }
        } else if (char === ',' && !insideQuotes) {
          currentRow.push(currentCell.trim());
          currentCell = '';
        } else if ((char === '\n' || (char === '\r' && nextChar === '\n')) && !insideQuotes) {
          if (char === '\r') i++;
          currentRow.push(currentCell.trim());
          if (currentRow.some((c) => c !== '')) rows.push(currentRow);
          currentRow = [];
          currentCell = '';
        } else {
          currentCell += char;
        }
      }
      if (currentCell.length > 0 || currentRow.length > 0) {
        currentRow.push(currentCell.trim());
        if (currentRow.some((c) => c !== '')) rows.push(currentRow);
      }
      return rows;
    }

    function handleExerciseLibraryCSV(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (e) {
        try {
          const rows = parseCSV(e.target.result);
          const imported = [];
          for (let i = 1; i < rows.length; i++) {
            const r = rows[i];
            if (r.length >= 3 && r[2]) {
              imported.push({
                id: `csv-ex-${i}`,
                pattern: r[0] || 'General',
                targetScore: r[1] || 'Score 2 & 3',
                name: r[2],
                category: r[3] || 'Movement',
                cues: r[4] || 'Follow prescribed tempo and controlled range of motion.'
              });
            }
          }
          if (imported.length > 0) {
            appState.exerciseLibrary = imported;
            saveState();
            renderExerciseLibrary();
            showToast(`Loaded ${imported.length} exercises from CSV!`, 'success');
          } else {
            showToast('No valid exercise rows found in CSV.', 'warning');
          }
        } catch (err) {
          showToast('Error parsing Exercise Library CSV.', 'error');
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

    function handleProgramTrackerCSV(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (e) {
        try {
          const rows = parseCSV(e.target.result);
          const newWeeks = { 1: [], 2: [], 3: [], 4: [] };
          let importedCount = 0;

          for (let i = 1; i < rows.length; i++) {
            const r = rows[i];
            // Expect columns: Week, Day, Date, Exercise, Sets, Reps, Weight, RPE, Notes
            const wkMatch = String(r[0] || '').match(/[1-4]/);
            const wk = wkMatch ? parseInt(wkMatch[0], 10) : 1;
            const dayName = r[1] || 'Day 1';
            const dateVal = r[2] || new Date().toISOString().split('T')[0];
            const exName = r[3];

            if (!exName || exName.toLowerCase() === 'exercise') continue;

            let dayObj = newWeeks[wk].find((d) => d.dayLabel === dayName);
            if (!dayObj) {
              dayObj = {
                id: `imp-w${wk}-d${newWeeks[wk].length + 1}`,
                dayLabel: dayName,
                date: dateVal,
                warmups: [],
                exercises: []
              };
              newWeeks[wk].push(dayObj);
            }

            dayObj.exercises.push({
              id: `imp-ex-${i}`,
              name: exName,
              sets: parseInt(r[4], 10) || 3,
              reps: r[5] || '10',
              weight: parseFloat(r[6]) || 0,
              rpe: parseFloat(r[7]) || 7.5,
              notes: r[8] || '',
              completed: false
            });
            importedCount++;
          }

          if (importedCount > 0) {
            appState.programWeeks = newWeeks;
            saveState();
            closeModal('modal-data-io');
            renderProgramTracker();
            showToast(`Imported ${importedCount} exercises into 4-Week Tracker!`, 'success');
          } else {
            showToast('Could not detect workout rows in CSV.', 'warning');
          }
        } catch (err) {
          showToast('Error importing Program CSV.', 'error');
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

    function exportProgramCSV() {
      const headers = ['Week', 'Day', 'Date', 'Exercise', 'Sets', 'Reps', 'Weight (lbs)', 'RPE', 'Notes', 'Completed'];
      const lines = [headers.join(',')];

      [1, 2, 3, 4].forEach((wk) => {
        (appState.programWeeks[wk] || []).forEach((day) => {
          day.exercises.forEach((ex) => {
            const row = [
              `Week ${wk}`,
              `"${day.dayLabel.replace(/"/g, '""')}"`,
              day.date,
              `"${ex.name.replace(/"/g, '""')}"`,
              ex.sets,
              `"${String(ex.reps).replace(/"/g, '""')}"`,
              ex.weight,
              ex.rpe,
              `"${(ex.notes || '').replace(/"/g, '""')}"`,
              ex.completed ? 'Yes' : 'No'
            ];
            lines.push(row.join(','));
          });
        });
      });

      downloadBlob(lines.join('\n'), `${appState.clientMeta.name.replace(/\s+/g, '_')}_4Week_Program.csv`, 'text/csv');
      showToast('Exported 4-Week Program CSV!', 'success');
    }

    function exportFullJSON() {
