          right: p.defaultR,
          clearing: p.clearing
        })),
        fmsComments: 'Left shoulder internal rotation & right inline lunge deficit noted during screen; keep overhead barbell/DB pressing restricted until Shoulder Mobility reaches >= 2. Re-test in 4 weeks.',
        exerciseLibrary: [...DEFAULT_EXERCISE_LIBRARY],
        exerciseVideos: {},
        mainLifts: [...DEFAULT_MAIN_LIFTS]
      };
      saveState();
      closeModal('modal-data-io');
      initUI();
      showToast('Template reset to default FMS & 4-Week program.', 'success');
    }

    // -----------------------------------------------------------------------
    // 6. TOAST NOTIFICATIONS (NO ALERT/CONFIRM)
    // -----------------------------------------------------------------------
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-slate-900 text-white border-l-4 border-emerald-400',
        warning: 'bg-slate-900 text-white border-l-4 border-amber-400',
        error: 'bg-slate-900 text-white border-l-4 border-rose-500',
        info: 'bg-slate-900 text-white border-l-4 border-teal-400'
      };
      toast.className = `${colors[type] || colors.info} px-4 py-3 rounded-xl shadow-xl text-xs font-semibold flex items-center justify-between gap-3 pointer-events-auto transition-all`;
      toast.innerHTML = `
        <span>${message}</span>
        <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        if (toast.parentElement) toast.remove();
      }, 3800);
    }

    // -----------------------------------------------------------------------
    // 7. NAVIGATION & MODE SWITCHING
    // -----------------------------------------------------------------------
    function switchTab(tabId) {
      appState.activeTab = tabId;
      document.querySelectorAll('.tab-panel').forEach((panel) => panel.classList.add('hidden'));
      document.getElementById(`tab-content-${tabId}`).classList.remove('hidden');

      document.querySelectorAll('.tab-nav-btn').forEach((btn) => {
        btn.classList.remove('border-emerald-400', 'text-emerald-400');
        btn.classList.add('border-transparent', 'text-slate-400');
      });
      const activeBtn = document.getElementById(`tab-btn-${tabId}`);
      activeBtn.classList.remove('border-transparent', 'text-slate-400');
      activeBtn.classList.add('border-emerald-400', 'text-emerald-400');

      if (tabId === 'tracker') renderProgramTracker();
      if (tabId === 'fms') renderFMSTab();
      if (tabId === 'library') renderExerciseLibrary();
      if (tabId === 'calculator') renderCalculatorTab();
      saveState();
    }

    function setAppMode(mode) {
      appState.mode = mode;
      const clientBtn = document.getElementById('btn-mode-client');
      const coachBtn = document.getElementById('btn-mode-coach');
      const indicatorPill = document.getElementById('mode-indicator-pill');

      if (mode === 'coach') {
        coachBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 bg-emerald-500 text-slate-950 shadow';
        clientBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 text-slate-300 hover:text-white';
        indicatorPill.textContent = 'Coach Edit Mode';
        indicatorPill.className = 'text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800';
      } else {
        clientBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 bg-emerald-500 text-slate-950 shadow';
