    function getRpeBadgeInfo(rpeVal) {
      const rpe = parseFloat(rpeVal) || 0;
      if (rpe >= 9.5) return { bg: 'bg-rose-100 text-rose-800 border-rose-200', rir: '0-1 RIR (Max Effort)' };
      if (rpe >= 8.5) return { bg: 'bg-amber-100 text-amber-800 border-amber-200', rir: '1-2 RIR (Hard)' };
      if (rpe >= 7.5) return { bg: 'bg-emerald-100 text-emerald-800 border-emerald-200', rir: '2-3 RIR (Target Strength)' };
      return { bg: 'bg-teal-50 text-teal-700 border-teal-200', rir: '3-5 RIR (Moderate / Tech)' };
    }

