    function applyModeVisibility() {
      const isCoach = appState.mode === 'coach';
      document.querySelectorAll('.coach-only-btn').forEach((el) => {
        el.style.display = isCoach ? '' : 'none';
      });
      document.querySelectorAll('.coach-editable').forEach((el) => {
        el.readOnly = !isCoach;
