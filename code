    function toggleExerciseComplete(week, dayId, exId) {
      const day = appState.programWeeks[week].find((d) => d.id === dayId);
      if (!day) return;
      const ex = day.exercises.find((e) => e.id === exId);
      if (!ex) return;
      ex.completed = !ex.completed;
      saveState();
      renderProgramTracker();
    }

    function updateExerciseField(week, dayId, exId, field, value) {
      const day = appState.programWeeks[week].find((d) => d.id === dayId);
      if (!day) return;
      const ex = day.exercises.find((e) => e.id === exId);
      if (!ex) return;
      if (field === 'sets' || field === 'weight' || field === 'rpe') {
        ex[field] = parseFloat(value) || 0;
      } else {
        ex[field] = value;
      }
      saveState();
      renderProgramTracker();
    }

    function updateDayField(week, dayId, field, value) {
      const day = appState.programWeeks[week].find((d) => d.id === dayId);
      if (!day) return;
      day[field] = value;
      saveState();
    }

    function addWorkoutDay(targetWeek = null) {
      const wk = targetWeek || (appState.selectedWeek === 'all' ? 1 : appState.selectedWeek);
      const existingDays = appState.programWeeks[wk] || [];
      const newNum = existingDays.length + 1;
      const todayIso = new Date().toISOString().split('T')[0];

      existingDays.push({
        id: `w${wk}-d${Date.now()}`,
        dayLabel: `Day ${newNum} — Full Body / Corrective Session`,
        date: todayIso,
        warmups: [
          { id: `wu-${Date.now()}`, name: 'Crocodile Breathing', prescription: '2 × 5 breaths' }
        ],
        exercises: [
          { id: `ex-${Date.now()}`, name: 'Goblet Squat', sets: 3, reps: 10, weight: 35, rpe: 7.5, notes: 'Controlled tempo', completed: false }
        ]
      });
      appState.programWeeks[wk] = existingDays;
      saveState();
      renderProgramTracker();
      showToast(`Added Day ${newNum} to Week ${wk}.`, 'success');
    }

    function removeWorkoutDay(week, dayId) {
      appState.programWeeks[week] = appState.programWeeks[week].filter((d) => d.id !== dayId);
      saveState();
      renderProgramTracker();
      showToast('Workout session removed.', 'info');
    }

    function removeExerciseFromDay(week, dayId, exId) {
      const day = appState.programWeeks[week].find((d) => d.id === dayId);
      if (!day) return;
      day.exercises = day.exercises.filter((e) => e.id !== exId);
      saveState();
      renderProgramTracker();
    }

    function removeWarmupDrill(week, dayId, wuId) {
      const day = appState.programWeeks[week].find((d) => d.id === dayId);
      if (!day) return;
      day.warmups = day.warmups.filter((w) => w.id !== wuId);
      saveState();
      renderProgramTracker();
    }

    // -----------------------------------------------------------------------
    // 9. TAB 2: FMS ASSESSMENT & RECOMMENDATIONS LOGIC
    // -----------------------------------------------------------------------
    function computeFmsRowMetrics(scoreObj) {
      if (scoreObj.clearing === 'Fail') {
        return {
          finalScore: 0,
          asymmetry: scoreObj.bilateral && scoreObj.left !== scoreObj.right ? 'Asymmetrical' : 'Symmetrical'
        };
      }
      const finalScore = scoreObj.bilateral ? Math.min(scoreObj.left, scoreObj.right) : scoreObj.left;
      const asymmetry = scoreObj.bilateral && scoreObj.left !== scoreObj.right ? 'Asymmetrical' : 'Symmetrical';
      return { finalScore, asymmetry };
    }

    function renderFMSTab() {
      const tbody = document.getElementById('fms-scorecard-body');
      const guardrailsContainer = document.getElementById('fms-guardrails-container');
      document.getElementById('fms-trainer-comments').value = appState.fmsComments || '';

      let count0 = 0;
      let count12 = 0;
      let count3 = 0;
      let compositeScore = 0;

      let rowsHtml = '';
      let guardrailsHtml = '';

      appState.fmsScores.forEach((s, idx) => {
        const def = FMS_PATTERN_DEFINITIONS.find((d) => d.id === s.id);
        const { finalScore, asymmetry } = computeFmsRowMetrics(s);
        compositeScore += finalScore;

        if (finalScore === 0) count0++;
        else if (finalScore <= 2) count12++;
        else count3++;

        let statusBadge = '';
        if (finalScore === 0) {
          statusBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800"><i class="fa-solid fa-circle-exclamation"></i> 0 = Pain / Medical Eval</span>`;
        } else if (finalScore <= 2) {
          statusBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800"><i class="fa-solid fa-wrench"></i> ${finalScore} = Modify & Mobilize</span>`;
        } else {
          statusBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800"><i class="fa-solid fa-circle-check"></i> 3 = Cleared for Full Load</span>`;
        }

        const asymBadge = asymmetry === 'Asymmetrical'
          ? `<span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">Asymmetrical</span>`
          : `<span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 text-slate-600">Symmetrical</span>`;

