<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Coach & Client Program Viewer | FMS & Programming Portal</title>
  <!-- PWA Meta Tags for iOS & Android Home Screen Installation -->
  <meta name="theme-color" content="#0f172a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="FMS Tracker" />
  <link id="pwa-apple-touch-icon" rel="apple-touch-icon" href="" />
  <link id="pwa-manifest-link" rel="manifest" href="" />
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
          colors: {
            slateDark: '#0f172a',
            slateCard: '#1e293b',
          }
        }
      }
    };
  </script>

  <style>
    /* Custom scrollbar & print rules */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @media print {
      .no-print {
        display: none !important;
      }
      body {
        background: #ffffff !important;
      }
      .print-card {
        box-shadow: none !important;
        border: 1px solid #cbd5e1 !important;
        break-inside: avoid;
      }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased selection:bg-emerald-500 selection:text-white">

  <!-- Toast Notification Banner (Replaces alert) -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- Top Navigation Header -->
  <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-lg border-b border-slate-800 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between py-3 gap-3">
        <!-- Brand Logo -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-slate-950 font-extrabold text-lg shadow-md">
            <i class="fa-solid fa-dumbbell"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-base sm:text-lg font-bold tracking-tight leading-tight">Coach & Client Program Viewer</h1>
              <span id="network-status-pill" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" title="Offline caching active for gym use">
                <span id="network-status-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span id="network-status-text">Online • Offline Ready</span>
              </span>
            </div>
            <p class="text-xs text-slate-400">FMS-Driven Programming & Progress Portal</p>
          </div>
        </div>

        <!-- Mode Toggle & Import/Export Controls -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <!-- Install Mobile App (PWA) Button -->
          <button id="btn-install-pwa" onclick="handleInstallAppClick()" class="px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 text-xs font-extrabold shadow-sm transition flex items-center gap-1.5" title="Install onto iPhone or Android Home Screen">
            <i class="fa-solid fa-mobile-screen-button"></i>
            <span>Install App</span>
          </button>

          <!-- Client View / Coach Edit Mode Toggle -->
          <div class="bg-slate-800 p-1 rounded-xl flex items-center border border-slate-700">
            <button id="btn-mode-client" onclick="setAppMode('client')" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 bg-emerald-500 text-slate-950 shadow">
              <i class="fa-solid fa-user-check"></i>
              <span>Client View</span>
            </button>
            <button id="btn-mode-coach" onclick="setAppMode('coach')" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 text-slate-300 hover:text-white">
              <i class="fa-solid fa-pen-to-square"></i>
              <span>Coach Edit</span>
            </button>
          </div>

          <!-- Import / Export Dropdown Trigger -->
          <button onclick="openDataModal()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition flex items-center gap-1.5" title="Import CSV/JSON or Export Workout">
            <i class="fa-solid fa-file-import text-emerald-400"></i>
            <span class="hidden sm:inline">Import / Export</span>
          </button>

          <!-- Print Button -->
          <button onclick="window.print()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition flex items-center gap-1.5" title="Print Workout Sheet">
            <i class="fa-solid fa-print text-teal-400"></i>
            <span class="hidden md:inline">Print</span>
          </button>
        </div>
      </div>

      <!-- 4 Core Spreadsheet Tabs Navigation -->
      <nav class="flex overflow-x-auto gap-1 pt-1 pb-0 border-t border-slate-800/80 scrollbar-none">
        <button onclick="switchTab('tracker')" id="tab-btn-tracker" class="tab-nav-btn whitespace-nowrap px-4 py-3 text-xs sm:text-sm font-semibold border-b-2 border-emerald-400 text-emerald-400 flex items-center gap-2 transition">
          <i class="fa-solid fa-calendar-check"></i>
          <span>4-Week Program Tracker</span>
        </button>
        <button onclick="switchTab('fms')" id="tab-btn-fms" class="tab-nav-btn whitespace-nowrap px-4 py-3 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition">
          <i class="fa-solid fa-person-walking"></i>
          <span>FMS Assessment & Recommendations</span>
        </button>
        <button onclick="switchTab('library')" id="tab-btn-library" class="tab-nav-btn whitespace-nowrap px-4 py-3 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition">
          <i class="fa-solid fa-book-open"></i>
          <span>Exercise Library</span>
          <span id="library-count-badge" class="px-1.5 py-0.5 text-[10px] rounded-full bg-slate-800 text-emerald-400 font-bold">52</span>
        </button>
        <button onclick="switchTab('calculator')" id="tab-btn-calculator" class="tab-nav-btn whitespace-nowrap px-4 py-3 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition">
          <i class="fa-solid fa-calculator"></i>
          <span>1RM & RPE Reference</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- Client Header Banner -->
    <section class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6 print-card">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex items-start sm:items-center gap-4">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-slate-900 text-emerald-400 flex items-center justify-center text-xl font-bold shrink-0 shadow-inner">
            <span id="client-initials">AM</span>
          </div>
          <div class="space-y-1 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800">Active Mesocycle</span>
              <span id="header-fms-summary-badge" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800">
                FMS Guardrails Active
              </span>
            </div>
            <!-- Editable Client Name & Phase -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 pt-1">
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-semibold text-slate-400 uppercase">Client:</span>
                <input id="client-name-input" type="text" value="Alex Mercer" onchange="updateClientMeta()" class="coach-editable font-bold text-lg text-slate-900 bg-transparent border-b border-transparent focus:border-emerald-500 focus:outline-none px-1 rounded transition" />
              </div>
              <div class="hidden sm:block text-slate-300">|</div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-semibold text-slate-400 uppercase">Phase:</span>
                <input id="client-phase-input" type="text" value="Block 1: Corrective Foundation & Strength Base" onchange="updateClientMeta()" class="coach-editable font-semibold text-sm text-teal-700 bg-transparent border-b border-transparent focus:border-emerald-500 focus:outline-none px-1 rounded w-full sm:w-80 transition" />
              </div>
            </div>
          </div>
        </div>

        <!-- Coach Notes Box -->
        <div class="lg:w-96 bg-slate-50 rounded-xl p-3 border border-slate-200/80">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 flex items-center gap-1.5">
              <i class="fa-solid fa-clipboard-list text-emerald-600"></i> Coach Focus & Notes
            </span>
            <span id="mode-indicator-pill" class="text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-200 text-slate-700">Client Mode</span>
          </div>
          <textarea id="coach-notes-input" rows="2" onchange="updateClientMeta()" class="coach-editable w-full text-xs text-slate-700 bg-transparent resize-none focus:outline-none focus:bg-white rounded p-1 transition" placeholder="Enter key programming priorities...">Prioritize Shoulder Mobility & Ankle Dorsiflexion drills in warm-up before main lower/upper lifts. Leave 2 reps in reserve (RPE 8) on primary compound sets.</textarea>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- TAB 1: 4-WEEK PROGRAM TRACKER                                       -->
    <!-- =================================================================== -->
    <div id="tab-content-tracker" class="tab-panel space-y-6">

      <!-- Week Selector & Action Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 no-print">
        <div class="flex flex-wrap items-center gap-2 bg-white p-1.5 rounded-2xl shadow-sm border border-slate-200">
          <button onclick="selectWeek(1)" id="week-pill-1" class="week-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition bg-slate-900 text-white shadow">Week 1</button>
          <button onclick="selectWeek(2)" id="week-pill-2" class="week-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition text-slate-600 hover:bg-slate-100">Week 2</button>
          <button onclick="selectWeek(3)" id="week-pill-3" class="week-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition text-slate-600 hover:bg-slate-100">Week 3</button>
          <button onclick="selectWeek(4)" id="week-pill-4" class="week-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition text-slate-600 hover:bg-slate-100">Week 4</button>
          <button onclick="selectWeek('all')" id="week-pill-all" class="week-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition text-slate-600 hover:bg-slate-100">All Weeks</button>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="addWorkoutDay()" class="coach-only-btn px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-sm transition flex items-center gap-2">
            <i class="fa-solid fa-plus text-emerald-400"></i>
            <span>Add Workout Day</span>
          </button>
        </div>
      </div>

      <!-- Dynamic KPI Summary Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Exercises</p>
            <p id="kpi-exercises" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">0</p>
            <p id="kpi-completed-sub" class="text-[11px] font-medium text-emerald-600 mt-0.5">0 completed</p>
          </div>
          <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-list-check"></i>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Sets</p>
            <p id="kpi-sets" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">0</p>
            <p class="text-[11px] font-medium text-slate-400 mt-0.5">Working sets</p>
          </div>
          <div class="w-11 h-11 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-layer-group"></i>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Volume</p>
            <p id="kpi-volume" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">0 <span class="text-sm font-semibold text-slate-400">lbs</span></p>
            <p class="text-[11px] font-medium text-slate-400 mt-0.5">Sets × Reps × Load</p>
          </div>
          <div class="w-11 h-11 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-weight-hanging"></i>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Average RPE</p>
            <p id="kpi-rpe" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">0.0</p>
            <p id="kpi-rpe-sub" class="text-[11px] font-medium text-amber-600 mt-0.5">Target intensity</p>
          </div>
          <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-gauge-high"></i>
          </div>
        </div>
      </div>

      <!-- Workout Days Container -->
      <div id="workout-days-container" class="space-y-6">
        <!-- Rendered dynamically by JS -->
      </div>
    </div>

    <!-- =================================================================== -->
    <!-- TAB 2: FMS ASSESSMENT & RECOMMENDATIONS                             -->
    <!-- =================================================================== -->
    <div id="tab-content-fms" class="tab-panel hidden space-y-6">

      <!-- FMS Summary Counters -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-2xl p-5 border-l-4 border-rose-500 border-y border-r border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-rose-600">Pain / Medical Flags (0)</p>
            <p id="fms-count-0" class="text-3xl font-extrabold text-slate-900 mt-1">0</p>
            <p class="text-xs text-slate-500 mt-0.5">Requires medical evaluation</p>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border-l-4 border-amber-500 border-y border-r border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-amber-600">Corrective Patterns (1-2)</p>
            <p id="fms-count-12" class="text-3xl font-extrabold text-slate-900 mt-1">0</p>
            <p class="text-xs text-slate-500 mt-0.5">Modify load & prioritize drills</p>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-wrench"></i>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border-l-4 border-emerald-500 border-y border-r border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">Optimal Patterns (3)</p>
            <p id="fms-count-3" class="text-3xl font-extrabold text-slate-900 mt-1">0</p>
            <p class="text-xs text-slate-500 mt-0.5">Cleared for full load</p>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
      </div>

      <!-- 7-Pattern FMS Screening Scorecard -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="bg-slate-900 text-white px-5 py-4 flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-base font-bold flex items-center gap-2">
              <i class="fa-solid fa-clipboard-check text-emerald-400"></i>
              7-Pattern FMS Screening Scorecard
            </h2>
            <p class="text-xs text-slate-400">Adjust Left/Right scores or Clearing Tests to dynamically update exercise guardrails</p>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-400 uppercase font-semibold">Composite Score:</span>
            <span id="fms-total-score" class="ml-1.5 px-3 py-1 rounded-lg bg-emerald-500 text-slate-950 font-extrabold text-sm">15 / 21</span>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                <th class="py-3 px-4">FMS Movement Pattern</th>
                <th class="py-3 px-3 text-center">Raw Score (L)</th>
                <th class="py-3 px-3 text-center">Raw Score (R)</th>
                <th class="py-3 px-3 text-center">Clearing Test</th>
                <th class="py-3 px-3 text-center">Final Score</th>
                <th class="py-3 px-3 text-center">Asymmetry</th>
                <th class="py-3 px-4">Pattern Status & Action</th>
              </tr>
            </thead>
            <tbody id="fms-scorecard-body" class="divide-y divide-slate-100 text-sm">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Dynamic Exercise Guardrails & Corrective Recommendations -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-6 space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
          <div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-shield-halved text-teal-600"></i>
              Active Exercise Guardrails & Corrective Recommendations
            </h3>
            <p class="text-xs text-slate-500">Automatically filtered from the FMS Assessment rules based on current pattern scores</p>
          </div>
        </div>

        <div id="fms-guardrails-container" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <!-- Populated dynamically by JS -->
        </div>

        <!-- Trainer Comments Box -->
        <div class="bg-slate-50 rounded-xl p-4 border border-slate-200">
          <label for="fms-trainer-comments" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Trainer Assessment Comments & Notes
          </label>
          <textarea id="fms-trainer-comments" rows="2" onchange="saveState()" class="w-full text-sm text-slate-800 bg-white border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="Add specific FMS observations, pain triggers, or re-screen dates...">Left shoulder internal rotation deficit noted during Shoulder Mobility screen; keep overhead barbell/DB pressing restricted until score reaches >= 2. Re-test in 4 weeks.</textarea>
        </div>
      </div>
    </div>

    <!-- =================================================================== -->
    <!-- TAB 3: EXERCISE LIBRARY (248-MOVEMENT DATABASE)                     -->
    <!-- =================================================================== -->
    <div id="tab-content-library" class="tab-panel hidden space-y-6">

      <!-- Search & Filter Controls -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-5 space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-900">FMS-Indexed Exercise Library</h2>
            <p class="text-xs text-slate-500">Filter by FMS Movement Pattern, Target FMS Score tier, or Category, and add straight to your workout plan</p>
          </div>
          <!-- CSV Upload Trigger for full 248 rows -->
          <div class="flex items-center gap-2">
            <label class="cursor-pointer px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition flex items-center gap-2 border border-slate-200">
              <i class="fa-solid fa-file-csv text-emerald-600"></i>
              <span>Load Exercise_Library.csv</span>
              <input type="file" accept=".csv" onchange="handleExerciseLibraryCSV(event)" class="hidden" />
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <!-- Search Input -->
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
            <input id="lib-search" type="text" oninput="renderExerciseLibrary()" placeholder="Search exercise or cue..." class="w-full pl-9 pr-3 py-2 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>

          <!-- Pattern Filter -->
          <select id="lib-filter-pattern" onchange="renderExerciseLibrary()" class="w-full px-3 py-2 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium text-slate-700">
            <option value="ALL">All 7 FMS Patterns</option>
            <option value="Deep Squat">Deep Squat</option>
            <option value="Hurdle Step">Hurdle Step</option>
