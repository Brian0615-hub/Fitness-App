    function initPWA() {
      // 1. Inject Apple Touch Icon & Dynamic Web App Manifest
      const appleIconEl = document.getElementById('pwa-apple-touch-icon');
      if (appleIconEl) appleIconEl.href = PWA_ICON_DATA_URI;

      const manifestLinkEl = document.getElementById('pwa-manifest-link');
      if (manifestLinkEl) {
        const manifestBlob = new Blob([JSON.stringify(PWA_MANIFEST_OBJECT, null, 2)], { type: 'application/manifest+json' });
        manifestLinkEl.href = URL.createObjectURL(manifestBlob);
      }

      // 2. Register Service Worker (supports external sw.js when hosted, with inline Blob fallback)
      if ('serviceWorker' in navigator && (window.location.protocol === 'https:' || window.location.protocol === 'http:')) {
        navigator.serviceWorker.register('./sw.js').catch(() => {
          try {
            const swBlob = new Blob([PWA_SERVICE_WORKER_CODE], { type: 'application/javascript' });
            const swUrl = URL.createObjectURL(swBlob);
            navigator.serviceWorker.register(swUrl).catch(() => {});
          } catch (e) {
            // Blob SW restricted in sandboxed preview; offline localStorage remains active
          }
        });
      }

      // 3. Listen for Android/Chrome native install prompt
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredInstallPrompt = e;
        const nativeBox = document.getElementById('pwa-native-prompt-box');
        if (nativeBox) nativeBox.classList.remove('hidden');
      });

      window.addEventListener('appinstalled', () => {
        deferredInstallPrompt = null;
        const nativeBox = document.getElementById('pwa-native-prompt-box');
        if (nativeBox) nativeBox.classList.add('hidden');
        showToast('FMS Program Tracker installed to your home screen!', 'success');
