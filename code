    // -----------------------------------------------------------------------
    // 8. TAB 1: 4-WEEK PROGRAM TRACKER LOGIC
    // -----------------------------------------------------------------------
    function selectWeek(wk) {
      appState.selectedWeek = wk;
      document.querySelectorAll('.week-pill').forEach((pill) => {
        pill.className = 'week-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition text-slate-600 hover:bg-slate-100';
