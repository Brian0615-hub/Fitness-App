                            <button onclick="toggleExerciseComplete(${wk}, '${day.id}', '${ex.id}')" class="w-6 h-6 rounded-lg border-2 flex items-center justify-center mx-auto transition ${ex.completed ? 'bg-emerald-500 border-emerald-500 text-white' : 'border-slate-300 hover:border-emerald-500 text-transparent'}">
